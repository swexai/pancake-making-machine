	(text "POWER ARCHITECTURE - DESIGN DECISION\n\nRev 0.1 (Prototype):\n\n* STM32 powered via USB.\n* +3V3 supplied by STM32 Nucleo.\n* +5V_CONTROL supplied from the logic-side 5V rail.\n* U21 generates +5V_FIELD from protected 24V.\n* GND_LOGIC and GND_FIELD remain isolated.\n\nRev 0.2 (Production):\n\n* Single external 24V power source.\n* Isolated 24V-to-5V converter for logic power.\n* USB retained for programming and diagnostics.\n* Independent protection for logic and field supplies.\n\nNOTE: Verify supply current, isolation and power sequencing.\n"
		(exclude_from_sim no)
		(at 65.024 115.062 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "77e7d879-c69f-4116-8e09-f8ba7dedfd86")
	)
	(text "POWER SUPPLY - ARCHITECTURE NOTE\n\n* 24V input: Mean Well HDR-150-24.\n* F1/D1: Overcurrent and reverse-polarity protection.\n* D2: Transient suppression; C1/C2: Supply filtering.\n* +24V_PROTECTED supplies field-side circuitry.\n* U21 converts 24V to +5V_FIELD.\n* +5V_CONTROL is externally supplied for motion control.\n* GND_FIELD and GND_LOGIC remain electrically isolated.\n* Motor power uses a separate supply branch.\n\nNOTE: Verify fuse ratings, supply isolation and protection before fabrication.\n"
		(exclude_from_sim no)
		(at 21.844 163.322 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f9b0b08c-6667-45ca-8959-e0584c3e8468")
	)
